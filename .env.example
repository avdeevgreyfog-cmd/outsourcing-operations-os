# PostgreSQL / Supabase / Neon / managed Postgres connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/outsourcing_operations_os

# Required outside local demo mode. Use at least 32 random bytes.
SESSION_SECRET=change-me-with-a-long-random-secret

# true = seeded demo user switcher is enabled. Never enable on an internet-facing production tenant.
DEMO_MODE=true

# Optional fixed demo organization UUID from migrations/seed.
DEMO_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
